#!/bin/bash
# SlowDNS — buat akun.
#   Jalankan sebagai root:  m-slowdns
# Akun yang dibuat = user SSH biasa (dipakai di aplikasi SlowDNS
# bersama Nameserver + Public key di bawah).
# Output akun memakai format kartu ala provider SSH (SSH WS/SSL,
# info host, port, SlowDNS, payload) biar gampang di-share ke pembeli.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Jalankan sebagai root (sudo)." >&2
  exit 1
fi

if [ ! -f /etc/slowdns/server.pub ]; then
  echo "SlowDNS belum terinstall."
  echo "Jalankan dulu: sudo bash slowdns/install-slowdns.sh"
  exit 1
fi

NS="$(grep '^Nameserver' /etc/slowdns/info.txt 2>/dev/null | awk '{print $3}')"
[ -z "$NS" ] && NS="slow.slowaethernal.eu.cc"
PUBKEY="$(cat /etc/slowdns/server.pub)"
IP="$(curl -s --max-time 5 ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')"
DOMAIN="$(cat /etc/xray/domain 2>/dev/null || echo slowaethernal.eu.cc)"

# Lokasi server (kota + ISP) buat info host; fallback = UpCloud SG.
GEO="$(curl -s --max-time 5 "http://ip-api.com/line/$IP?fields=status,city,isp" 2>/dev/null)"
if [ "$(echo "$GEO" | sed -n '1p')" = "success" ]; then
  CITY="$(echo "$GEO" | sed -n '2p')"
  ISP="$(echo "$GEO" | sed -n '3p')"
else
  CITY="Singapore"
  ISP="UpCloud"
fi
[ -z "$CITY" ] && CITY="Singapore"
[ -z "$ISP" ] && ISP="UpCloud"

clear
echo "===== BUAT AKUN SLOWDNS ====="
read -rp "Username : " username
read -rp "Password : " password
read -rp "Masa aktif (hari, default 30) : " days

case "$days" in
  ''|*[!0-9]*) days=30 ;;
esac

if ! [[ "$username" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "Username hanya boleh huruf, angka, _ dan -." >&2
  exit 1
fi
if [ -z "$password" ]; then
  echo "Password tidak boleh kosong." >&2
  exit 1
fi
if id "$username" &>/dev/null; then
  echo "Username $username sudah ada." >&2
  exit 1
fi

expiry=$(date -d "+${days} days" +%Y-%m-%d)
useradd -M -s /bin/false -e "$expiry" "$username"
echo "$username:$password" | chpasswd

clear
echo "============================="
echo " AKUN SLOWDNS"
echo "============================="
echo ""
echo "[ SSH DETAILS ]"
echo "-----------------------------"
echo "SSH WS      : $DOMAIN:80@$username:$password"
echo "SSH SSL     : $DOMAIN:443@$username:$password"
echo ""
echo "[ HOST INFORMATION ]"
echo "-----------------------------"
echo "Hostname    : $DOMAIN"
echo "City        : $CITY"
echo "ISP         : $ISP"
echo "Username    : $username"
echo "Password    : $password"
echo "Expiry Date : $expiry ($days hari)"
echo "Quota       : Unlimited"
echo ""
echo "[ PORTS ]"
echo "------------------------------"
echo "TLS         : 443, 2096"
echo "Non-TLS     : 80, 2082"
echo "UDPGW       : 7300"
echo ""
echo "[ SLOWDNS ]"
echo "------------------------------"
echo "NS          : $NS"
echo "Pubkey      : $PUBKEY"
echo "DNS         : $IP:53"
echo ""
echo "[ PAYLOAD WS ]"
echo "------------------------------"
echo "GET / HTTP/1.1[crlf]Host: [host][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf][crlf]"
echo ""
echo "[ PAYLOAD WSS ]"
echo "------------------------------"
echo "GET wss://[host]/ssh-wss HTTP/1.1[crlf]Host: [host][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf][crlf]"
echo "------------------------------"
echo "Isi di aplikasi SlowDNS:"
echo "  Server     : $DOMAIN ($IP)"
echo "  Nameserver : $NS"
echo "  Public key : (di atas)"
echo "  Username   : $username"
echo "  Password   : $password"
echo "  Port       : 22"
echo "============================="
echo "© Nexus Vpn"
echo ""
read -n 1 -s -r -p "Tekan tombol apa saja untuk kembali ke menu..."
echo ""
if command -v menu >/dev/null 2>&1; then
  exec menu
fi
exit 0
